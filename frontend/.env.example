# Copy to .env in frontend/ and adjust for your environment.
# BUN_PUBLIC_* vars are inlined into the browser bundle by `bun dev` / `bun run build.ts`
# (only these are exposed to client code, see frontend/bunfig.toml).
BUN_PUBLIC_API_BASE=http://localhost:8000/api
BUN_PUBLIC_WS_BASE=ws://localhost:8000